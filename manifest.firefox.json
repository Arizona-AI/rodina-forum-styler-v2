{
  "manifest_version": 3,
  "name": "Rodina Forum Styler",
  "short_name": "Rodina Styler",
  "version": "1.4.1",
  "description": "Темы, фоны, эффекты, шрифты и кастомизация интерфейса для форума Rodina RolePlay (forum.rodina-rp.com).",
  "permissions": ["storage"],
  "optional_host_permissions": ["https://*/*"],
  "content_scripts": [
    {
      "matches": ["https://forum.rodina-rp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Rodina Forum Styler",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "rodina-forum-styler@jengas.dev",
      "strict_min_version": "115.0"
    }
  }
}
